FROM mcr.microsoft.com/azure-databases/data-api-builder:latest

# Copy DAB configuration files (multi-data-source for read scale-out)
# Top-level config has write entities + references replica and analytics child configs
COPY dab-config.json /App/dab-config.json
COPY dab-config.replica.json /App/dab-config.replica.json
COPY dab-config.analytics.json /App/dab-config.analytics.json

# DAB will automatically use dab-config.json from /App
