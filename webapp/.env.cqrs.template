# CQRS Configuration for Data API Builder
# =========================================
# This file configures three connection strings for CQRS pattern with Azure SQL Hyperscale:
# 1. PRIMARY - Read/Write connection to primary replica
# 2. READONLY - Read-only connection using ApplicationIntent=ReadOnly for HA replicas
# 3. ANALYTICS - Connection to Named Replica for heavy analytics workloads

# Azure AD / Entra ID Authentication Settings
AZURE_AD_AUDIENCE=api://your-client-id
AZURE_AD_ISSUER=https://login.microsoftonline.com/your-tenant-id/v2.0

# ===========================================
# PRIMARY CONNECTION (Read/Write Operations)
# ===========================================
# Used by: dab-config.cqrs-write.json
# Targets: Primary database replica
# Operations: INSERT, UPDATE, DELETE
SQL_CONNECTION_STRING_PRIMARY=Server=tcp:your-server.database.windows.net,1433;Database=ZavaTaxDB;Authentication=Active Directory Managed Identity;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;

# ===========================================
# READONLY CONNECTION (Read Operations)
# ===========================================
# Used by: dab-config.cqrs-read.json  
# Targets: HA Read Replicas via ApplicationIntent=ReadOnly
# Operations: SELECT queries for tax filers, professionals
# Note: ApplicationIntent=ReadOnly routes to secondary replicas automatically
SQL_CONNECTION_STRING_READONLY=Server=tcp:your-server.database.windows.net,1433;Database=ZavaTaxDB;Authentication=Active Directory Managed Identity;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;ApplicationIntent=ReadOnly;

# ===========================================
# ANALYTICS CONNECTION (Named Replica)
# ===========================================
# Used by: dab-config.cqrs-analytics.json
# Targets: Dedicated Named Replica for analytics workloads
# Operations: Heavy analytics, dashboards, HTAP queries
# Note: Named replica has its own server endpoint for workload isolation
SQL_CONNECTION_STRING_ANALYTICS=Server=tcp:your-server-analytics.database.windows.net,1433;Database=ZavaTaxDB;Authentication=Active Directory Managed Identity;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;ApplicationIntent=ReadOnly;

# ===========================================
# Local Development (SQL Server)
# ===========================================
# Uncomment these for local SQL Server development:
# SQL_CONNECTION_STRING_PRIMARY=Server=localhost;Database=ZavaTaxDB;Trusted_Connection=True;TrustServerCertificate=True;
# SQL_CONNECTION_STRING_READONLY=Server=localhost;Database=ZavaTaxDB;Trusted_Connection=True;TrustServerCertificate=True;
# SQL_CONNECTION_STRING_ANALYTICS=Server=localhost;Database=ZavaTaxDB;Trusted_Connection=True;TrustServerCertificate=True;
