# Azure AD Configuration (for production)
VITE_AZURE_AD_CLIENT_ID=your-azure-ad-client-id
VITE_AZURE_AD_TENANT_ID=your-azure-ad-tenant-id

# API Configuration
VITE_API_BASE_URL=http://localhost:5000

# Set to 'true' for local development without Azure AD
VITE_DEV_MODE=false

# ============================================
# Data API Builder Environment Variables
# ============================================

# For Azure SQL DB Hyperscale (production):
# SQL_CONNECTION_STRING=Server=your-server.database.windows.net;Database=ZavaTax;Authentication=Active Directory Default;

# For SQL Server Express (local dev):
# SQL_CONNECTION_STRING=Server=localhost\\SQLEXPRESS;Database=ZavaTax;Trusted_Connection=True;TrustServerCertificate=True;

# For LocalDB (local dev):
# SQL_CONNECTION_STRING=Server=(localdb)\\MSSQLLocalDB;Database=ZavaTax;Integrated Security=True;TrustServerCertificate=True;

# Azure AD for DAB (production only)
# AZURE_AD_AUDIENCE=api://your-app-id
# AZURE_AD_ISSUER=https://login.microsoftonline.com/your-tenant-id/v2.0
