# Copy this file to .env and fill in your values
# DO NOT commit .env to source control
#
# NOTE: If you deployed via deploy.ps1, this file is auto-generated
# with actual Azure resource names — no manual editing needed.

# Authentication: Uses Azure DefaultAzureCredential
# This automatically uses (in order):
#   1. Environment variables (AZURE_CLIENT_ID, AZURE_TENANT_ID, AZURE_CLIENT_SECRET)
#   2. Managed Identity (when running in Azure)
#   3. Azure CLI credentials (az login)
#   4. Visual Studio / VS Code credentials

# Optional: Specify user-assigned managed identity client ID
# AZURE_CLIENT_ID=your-managed-identity-client-id

# Azure OpenAI Configuration (used by 03_generate_embeddings.py, 05_embed_scenarios.py)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-01

# Azure SQL Database Configuration (used by 07_load_to_azure_sql.py)
SQL_SERVER=your-server.database.windows.net
SQL_DATABASE=zavataxdb

# Storage (used by 07_load_to_azure_sql.py for BULK INSERT from blob)
STORAGE_ACCOUNT=your-storage-account-name
STORAGE_CONTAINER=csvdata
IDENTITY_CLIENT_ID=your-managed-identity-client-id

# Data generation scale factors (used by run_all.ps1 and individual scripts)
# These control how much data is generated. Larger values = longer generation
# time and bigger database after running 08_generate_filing_details.sql.
#
#   PUBLICATION_PRIORITY  IRS publication download tier 1-4 (01_download_irs_pubs.py)
#                          1 = Core (12 pubs), 2 = +Deductions/Credits (40),
#                          3 = +Business/Self-employed (75), 4 = All (100)
#   SCENARIO_COUNT     Tax scenarios for knowledge search demo (04_generate_scenarios.py)
#   OPERATIONAL_ROWS   Tax return rows (06_generate_operational_data.py)
#   BRANCHES           Number of branch offices (06_generate_operational_data.py)
#   CUSTOMERS          Number of customer records (06_generate_operational_data.py)
#   PROFESSIONALS      Min tax professionals; auto-scales to 3-8 per branch (06_generate_operational_data.py)
#   CHUNK_SIZE         Tokens per knowledge base chunk (02_parse_and_chunk.py)
#
# Presets (OPERATIONAL_ROWS → approx DB size after filing detail generation):
#   Quick demo:   100000   → ~1 GB
#   Default:      1000000  → ~10 GB
#   Large demo:   10000000 → ~100 GB
#   Full scale:   50000000 → ~300+ GB
#
PUBLICATION_PRIORITY=4
SCENARIO_COUNT=5000
OPERATIONAL_ROWS=1000000
BRANCHES=500
CUSTOMERS=10000
PROFESSIONALS=2500
CHUNK_SIZE=500
