# Copy this file to .env and configure for your environment

# Authentication: Uses Azure DefaultAzureCredential
# This automatically uses (in order):
#   1. Managed Identity (when running in Azure Container Apps)
#   2. Environment credentials (AZURE_CLIENT_ID, AZURE_TENANT_ID, AZURE_CLIENT_SECRET)
#   3. Azure CLI credentials (az login)
#   4. Visual Studio / VS Code credentials

# Optional: Specify user-assigned managed identity client ID
# AZURE_CLIENT_ID=your-managed-identity-client-id

# ============================================================================
# Database Connection (Azure AD authentication only)
# ============================================================================

# Primary server for write load simulator (main.py):
SQL_SERVER=your-server.database.windows.net
SQL_DATABASE=zavatax-2026

# Named replica for analytics load simulator (analytics_load_test.py):
# Use the -s/--server flag to override, or set SQL_SERVER to the replica endpoint
# Example: SQL_SERVER=your-server-replica.database.windows.net

SQL_CONNECTION_TIMEOUT=30

# Load Configuration
NUM_WORKERS=10
BATCH_SIZE=1000
BATCHES_PER_WORKER=1000
TARGET_THROUGHPUT_MBPS=50
MAX_THROUGHPUT_MBPS=150
DURATION_SECONDS=300
WARMUP_SECONDS=30

# Data Generation
NUM_BRANCHES=500
NUM_PROFESSIONALS=2000
NUM_CUSTOMERS=100000

# Insert Method
USE_JSON_INSERT=true
USE_BULK_INSERT=false

# Logging
LOG_LEVEL=INFO
